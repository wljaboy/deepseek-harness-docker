# ===== DeepSeek Harness NAS 环境变量 =====

# 你的 NAS 局域网 IP（如 192.168.1.111），或公网域名（纯域名，不带协议和端口）
HTTPS_ACCESS_HOST=192.168.1.111

# 可选：公网域名（纯域名，不带协议和端口）。设置后局域网 IP 与公网域名都能访问，
# 需配合 Cloudflare Tunnel 使用。留空则仅局域网可访问。
# DSH_PUBLIC_HOST=harness.yourdomain.com

# 登录用户名（浏览器访问 https://NAS_IP:8443 时使用）
DSH_AUTH_USERNAME=admin

# 登录密码（必须至少 12 个字符，请设置一个足够长的独立密码）
DSH_AUTH_PASSWORD=请修改为至少12位的强密码

# 模型 API Key（必填）：到 https://platform.deepseek.com 注册后创建，填入你以 sk- 开头的密钥。
# 填好后 AI 即可直接使用（无需再进网页设置页）。
DEEPSEEK_API_KEY=sk-在这里填入你的密钥

# 持久化目录（请改为你 NAS 上的实际绝对路径）
DSH_DATA_PATH=/volume1/docker/deepseek-harness/data
WORKSPACE_PATH=/volume1/docker/deepseek-harness/workspace

# ===== 可选：回环设置端口（用于首次通过回环 URL 配置 API Key）=====
# 远程(局域网 IP/域名)访问时，官方 DSH 设置页不可用（settings are unavailable
# in this browser）。设置本端口后（如 18080），配合本机 SSH 隧道即可进入设置页：
#   1) .env 取消注释并设置 DSH_SETUP_PORT=18080（可改成任意端口）
#   2) 本机执行: ssh -L 18080:127.0.0.1:18080 <你的NAS>
#   3) 浏览器打开 http://127.0.0.1:18080 ，即可配置模型 API Key
# 该端口只发布到宿主机回环(127.0.0.1)，不会暴露到局域网/公网。
# 留空或不设置则关闭此项。
DSH_SETUP_PORT=
